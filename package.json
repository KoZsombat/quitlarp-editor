{
  "name": "xterm-wasm-ide",
  "repository": { "type": "git", "url": "git+https://github.com/KoZsombat/quitlarp-editor.git" },
  "version": "0.1.0",
  "description": "Mini VS Code-style IDE in the browser: explorer, Monaco, and a real bash (WASIX) terminal. No backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/style.css dist/style.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite demo",
    "demo:build": "vite build demo"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0"
  },
  "peerDependencies": {
    "@wasmer/sdk": "^0.19.0"
  },
  "devDependencies": {
    "@wasmer/sdk": "^0.19.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MPL-2.0"
}
